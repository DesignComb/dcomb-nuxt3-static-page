":47,"type":48,"number":592},8,{"id":51,"type":32,"multi_select":594},[595],{"id":407,"name":408,"color":396},{"id":62,"type":22,"rich_text":597},[598],{"type":25,"text":599,"annotations":600,"plain_text":413,"href":14},{"content":413,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":69,"type":70,"url":14},{"id":73,"type":40,"files":603},[604],{"name":605,"type":44,"external":606},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/kokoni-web.webp",{"url":605},{"id":82,"type":22,"rich_text":608},[609],{"type":25,"text":610,"annotations":611,"plain_text":86,"href":14},{"content":86,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":89,"type":70,"url":613},"https://abby-select-store.myshopify.com",{"id":92,"type":22,"rich_text":615},[616],{"type":25,"text":617,"annotations":619,"plain_text":618,"href":14},{"content":618,"link":14},"Kokoni 是「這裏」的意思。透過主理人以及品牌團隊的嚴選，我們期望大家能在這裡找到好吃、好喝、好用、好美的好物。讓我們一起好好生活，慢慢相遇。\n\n根據品牌意象，網頁用極簡的風格，純白的基調，再加上主理人的形象去建置，簡約的畫面，讓大家能在網頁上專注選擇 Kokoni 的商品。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":99,"type":99,"title":621},[622],{"type":25,"text":623,"annotations":625,"plain_text":624,"href":14},{"content":624,"link":14},"Kokoni 小日常道具｜電商網站",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":106,"type":107,"date":627},{"start":628,"end":14,"time_zone":14},"2022-11-01","https://www.notion.so/Kokoni-58877f554e33420281e65916f844de0a",{"object":7,"id":631,"created_time":9,"last_edited_time":9,"created_by":632,"last_edited_by":633,"cover":14,"icon":14,"parent":634,"in_trash":18,"is_archived":18,"is_locked":18,"properties":635,"url":695,"public_url":14,"archived":18},"e8a781ab-0526-431a-aff4-5981ff150868",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":636,"Tags":641,"Cover":644,"Sort":649,"Skill":651,"LinkRemarks":657,"GitHub":659,"ProjectImage":6