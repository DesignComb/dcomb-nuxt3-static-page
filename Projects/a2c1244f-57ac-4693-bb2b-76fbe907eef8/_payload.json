8,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":99,"type":99,"title":171},[172],{"type":25,"text":173,"annotations":175,"plain_text":174,"href":14},{"content":174,"link":14},"CAPSULE 創作者官網｜形象網站",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":106,"type":107,"date":177},{"start":178,"end":14,"time_zone":14},"2021-03-01","https://www.notion.so/CAPSULE-05bbe82b6904467eacfc4f82f6e9369d",{"object":7,"id":181,"created_time":182,"last_edited_time":183,"created_by":184,"last_edited_by":185,"cover":14,"icon":14,"parent":186,"in_trash":18,"is_archived":18,"is_locked":18,"properties":187,"url":254,"public_url":14,"archived":18},"3555f4b6-5a43-8077-b7b7-e73ba21048ea","2026-05-03T12:44:00.000Z","2026-05-04T11:45:00.000Z",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":188,"Tags":194,"Cover":197,"Sort":202,"Skill":204,"LinkRemarks":210,"GitHub":212,"ProjectImage":213,"Client":227,"Link":233,"Text":234,"Name":240,"Update":251},{"id":21,"type":22,"rich_text":189},[190],{"type":25,"text":191,"annotations":193,"plain_text":192,"href":14},{"content":192,"link":14},"• 前端開發\n• 後端開發\n• 資料庫設計",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":195},[196],{"id":35,"name":36,"color":37},{"id":39,"type":40,"files":198},[199],{"name":200,"type":44,"external":201},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812519997.jpg",{"url":200},{"id":47,"type":48,"number":203},3,{"id":51,"type":32,"multi_select":205},[206,209],{"id":207,"name":208,"color":37},"24482c8e-31ff-4e50-b48e-23766e4181ea","Python",{"id":54,"name":55,"color":56},{"id":62,"type":22,"rich_text":211},[],{"id":69,"type":70,"url":14},{"id":73,"type":40,"files":214},[215,218,221,224],{"name":216,"type":44,"external":217},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812594537.jpg",{"url":216},{"name":219,"type":44,"external":220},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812629168.jpg",{"url":219},{"name":222,"type":44,"external":223},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812660414.jpg",{"url":222},{"name":225,"type":44,"external":226},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812695286.jpg",{"url":225},{"id":82,"type":22,"rich_text":228},[229],{"type":25,"text":230,"annotations":232,"plain_text":231,"href":14},{"content":231,"link":14},"IMstudy",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":89,"type":70,"url":14},{"id":92,"type":22,"rich_text":235},[236],{"type":25,"text":237,"annotations":239,"plain_text":238,"href":14},{"content":238,"link":14},"IMStudy（愛學館）是一套專為補習班與家教中心打造的學習管理系統，將學生與師資管理、課程配置、學收單（帳務）、排課調課與 LINE 通知串接整合於同一平台，協助補教機構把原本分散的行政流程數位化、集中化，大幅減少人工對帳與紙本作業的負擔。\n\n系統涵蓋從學生報名、課堂排程、請假調補課到帳務追蹤的完整營運鏈路，並支援多分校管理與角色權限分工，讓櫃檯、導師與管理  階層能依職務各司其職；同時透過 LINE 即時推播課堂與繳費資訊給家長，強化校方與家庭之間的溝通效率。 ",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":99,"type":99,"title":241},[242,247],{"type":25,"text":243,"annotations":245,"plain_text":244,"href":14},{"content":244,"link":14},"愛學館後台管理",{"bold":246,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},true,{"type":25,"text":248,"annotations":250,"plain_text":249,"href":14},{"content":249,"link":14},"系統｜CMS系統",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":106,"type":107,"date":252},{"start":253,"end":14,"time_zone":14},"2021-09-01","https://www.notion.so/CMS-3555f4b65a438077b7b7e73ba21048ea",{"object":7,"id":256,"created_time":9,"last_edited_time":257,"created_by":258,"last_edited_by":259,"cover":14,"icon":14,"parent":260,"in_trash":18,"is_archived":18,"is_locked":18,"properties":261,"url":317,"public_url":14,"archived":18},"d1c5aec2-0033-4f37-b34d-8c65568468d8","2026-05-03T12:56:00.000Z",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":262,"Tags":268,"Cover":274,"Sort":279,"Skill":281,"LinkRemarks":288,"GitHub":290,"ProjectImage":291,"Client":295,"Link":301,"Text":302,"Name":308,"Update":314},{"id":21,"type":22,"rich_text":263},[264],{"type":25,"text":265,"annotations":267,"plain_text":266,"href":14},{"content":266,"link":14},"• 介面設計\n• 流程設計\n• 前端開發\n• 後端開發\n• 資料庫設計",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":269},[270],{"id":271,"name":272,"color":273},"84b3d8fb-9032-4790-b0b4-7ce12ffb8eb5","線上工具","red",{"id":39,"type":40,"files":275},[276],{"name":277,"type":44,"external":278},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/link-manage.webp",{"url":277},{"id":47,"type":48,"number":280},4,{"id":51,"type":32,"multi_select":282},[283,284,285],{"id":54,"name":55,"color":56},{"id":58,"name":59,"color":60},{"id":286,"name":287,"color":37},"d90efa4b-32a4-45d3-8edf-45bd1d7845ff","Golang",{"id":62,"type":22,"rich_text":289},[],{"id":69,"type":70,"url":14},{"id":73,"type":40,"files":292},[293],{"name":277,"type":44,"external":294},{"url":277},{"id":82,"type":22,"rich_text":296},[297],{"type":25,"text":298,"annotations":300,"plain_text":299,"href":14},{"content":299,"link":14},"Design Comb",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":89,"type":70,"url":14},{"id":92,"type":22,"rich_text":303},[304],{"type":25,"text":305,"annotations":307,"plain_text":306,"href":14},{"content":306,"link":14},"這不只是縮網址!\n我們觀察到縮網址在社群媒體分享資訊時的廣泛應用，但在FB貼文、Line對話貼上一段縮網址，我們只能在預覽看到縮網址平台的資料，很不安心。\n因此，我們的工具在縮網址的同時還能編輯網頁的預覽資訊，這樣發文、傳資料的可信度就又能更上一層樓，更不用說有些SPA的網頁沒辦法針對單頁的資訊預覽，只要透過我們的網址工具，都能完美解決。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":99,"type":99,"title":309},[310],{"type":25,"text":311,"annotations":313,"plain_text":312,"href":14},{"content":312,"link":14},"LinkLink網址管理｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18