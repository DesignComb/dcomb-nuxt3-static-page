":18,"underline":18,"code":18,"color":29},{"id":89,"type":70,"url":363},"https://designcomb.github.io/chatGPT-speaker/",{"id":92,"type":22,"rich_text":365},[366],{"type":25,"text":367,"annotations":369,"plain_text":368,"href":14},{"content":368,"link":14},"ChatGPT的易用性相信有目共睹，只要輸入您的問題或想法，AI就能為您解答，而在我們的網站中，還能將這些文字轉成有情感的聲音，讀出來給你聽。\n\n我們專為中文用戶量身訂做，透過微軟的Azure服務，確保每一個字都發音準確，同時可以客製音調、音高，自由排序重組聲音順序等。真正做到讓ChatGPT念給你聽。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":99,"type":99,"title":371},[372],{"type":25,"text":373,"annotations":375,"plain_text":374,"href":14},{"content":374,"link":14},"AI 碎碎念｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":106,"type":107,"date":377},{"start":378,"end":14,"time_zone":14},"2023-04-01","https://www.notion.so/AI-8433259ec69041cca860a1bff8b22684",{"object":7,"id":381,"created_time":9,"last_edited_time":9,"created_by":382,"last_edited_by":383,"cover":14,"icon":14,"parent":384,"in_trash":18,"is_archived":18,"is_locked":18,"properties":385,"url":446,"public_url":14,"archived":18},"d83bfd28-c5e7-4c99-ba7d-e0d4d0e4088a",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":386,"Tags":391,"Cover":397,"Sort":402,"Skill":404,"LinkRemarks":409,"GitHub":415,"ProjectImage":416,"Client":424,"Link":429,"Text":431,"Name":437,"Update":443},{"id":21,"type":22,"rich_text":387},[388],{"type":25,"text":389,"annotations":390,"plain_text":121,"href":14},{"content":121,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":392},[393],{"id":394,"name":395,"color":396},"dd6d99a6-fef9-49aa-b38b-b0f1a3a8b248","電商網頁","green",{"id":39,"type":40,"files":398},[399],{"name":400,"type":44,"external":401},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/kamikami-cover.webp",{"url":400},{"id":47,"type":48,"number":403},5,{"id":51,"type":32,"multi_select":405},[406],{"id":407,"name":408,"