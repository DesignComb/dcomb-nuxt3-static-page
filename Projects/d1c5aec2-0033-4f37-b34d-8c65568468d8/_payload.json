3,"href":14},{"content":713,"link":14},"Finger Heart是一款專為校內外傳情活動所設計的平台，可以在上面建置活動讓大家參加，也可以在上面搜尋靈感，尋找吻合活動主題的商品，更有清晰美觀的後台可以進行訂單管理、商品、組合建立，也有彈性的付款機制。\n\n用Finger Heart輕鬆搞定活動複雜的部份，單純享受傳情帶來的快樂！",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":716},[717],{"type":25,"text":718,"annotations":720,"plain_text":719,"href":14},{"content":719,"link":14},"傳情訂單管理系統｜CMS 系統",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":722},{"start":723,"end":14,"time_zone":14},"2018-12-01","https://www.notion.so/CMS-e8a781ab0526431aaff45981ff150868",{"object":7,"id":726,"created_time":9,"last_edited_time":9,"created_by":727,"last_edited_by":728,"cover":14,"icon":14,"parent":729,"in_trash":18,"is_archived":18,"is_locked":18,"properties":730,"url":787,"public_url":14,"archived":18},"44cac559-1bf6-40ed-b37b-5fafe0f9f0d5",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":731,"Tags":737,"Cover":740,"Sort":746,"Skill":748,"LinkRemarks":754,"GitHub":756,"ProjectImage":757,"Client":765,"Link":771,"Text":772,"Name":778,"Update":784},{"id":21,"type":22,"rich_text":732},[733],{"type":25,"text":734,"annotations":736,"plain_text":735,"href":14},{"content":735,"link":14},"• 前端開發\n• 後端開發",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":738},[739],{"id":35,"name":36,"color":37},{"id":39,"type":40,"files":741},[742],{"name":743,"type":44,"external":744},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/NCKU-sleep-center-cover.webp",{"url":745},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/NCKU-sleep-center-cover.webp",{"id":48,"type":49,"number":747},10,{"id":52,"type":32,"multi_select":749},[750,753],{"id":751,"name":752,"color":681},"fee1f634-b0c0-4f1f-8004-452b31462744","Laravel",{"id":55,"name":56,"color":57},{"id":63,"type":22,"rich_text":755},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":758},[759,761],{"name":743,"type":44,"external":760},{"url":745},{"name":762,"type":44,"external":763},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/NCKU-sleep-center-02.webp",{"url":764},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/NCKU-sleep-center-02.webp",{"id":85,"type":22,"rich_text":766},[767],{"type":25,"text":768,"annotations":770,"plain_text":769,"href":14},{"content":769,"link":14},"NCKU AI4DT",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":773},[774],{"type":25,"text":775,"annotations":777,"plain_text":776,"href":14},{"content":776,"link":14},"協助成大睡眠中心管理受測者的資料和數值，為了提升工作效率和資料解讀的精確性，對目前的系統進行前端及UI優化。\n\n通過圖表和顏色指示來呈現數據，使數據變得更生動且易於解讀。例如利用紅、黃、綠三種底色分別表示數值異常、數值稍有偏離正常範圍及數值正常。此方式能迅速告知使用者資料的狀態。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":779},[780],{"type":25,"text":781,"annotations":783,"plain_text":782,"href":14},{"content":782,"link":14},"成大睡眠中心檢測系統｜CMS 系統",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":785},{"start":786,"end":14,"time_zone":14},"2021-06-01","https://www.notion.so/CMS-44cac5591bf640edb37b5fafe0f9f0d5",{"object":7,"id":789,"created_time":9,"last_edited_time":9,"created_by":790,"last_edited_by":791,"cover":14,"icon":14,"parent":792,"in_trash":18,"is_archived":18,"is_locked":18,"properties":793,"url":851,"public_url":14,"archived":18},"a2c1244f-57ac-4693-bb2b-76fbe907eef8",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":794,"Tags":800,"Cover":803,"Sort":809,"Skill":811,"LinkRemarks":819,"GitHub":821,"ProjectImage":822,"Client":830,"Link":835,"Text":836,"Name":842,"Update":848},{"id":21,"type":22,"rich_text":795},[796],{"type":25,"text":797,"annotations":799,"plain_text":798,"href":14},{"content":798,"link":14},"• 後端開發\n• 桌面應用程式開發\n• 農業資料開放平台系統串接\n• 資料庫設計",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":801},[802],{"id":35,"name":36,"color":37},{"id":39,"type":40,"files":804},[805],{"name":806,"type":44,"external":807},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/AI4DT-Center-01.webp",{"url":808},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/AI4DT-Center-01.webp",{"id":48,"type":49,"number":810},11,{"id":52,"type":32,"multi_select":812},[813,814,815],{"id":55,"name":56,"color":57},{"id":751,"name":752,"color":681},{"id":816,"name":817,"color":818},"63b4a48c-9ef0-42db-b0a1-136bdec0576a","ASP.net","gray",{"id":63,"type":22,"rich_text":820},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":823},[824,826],{"name":806,"type":44,"external":825},{"url":808},{"name":827,"type":44,"external":828},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/AI4DT-Center-02.webp",{"url":829},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/AI4DT-Center-02.webp",{"id":85,"type":22,"rich_text":831},[832],{"type":25,"text":833,"annotations":834,"plain_text":769,"href":14},{"content":769,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":837},[838],{"type":25,"text":839,"annotations":841,"plain_text":840,"href":14},{"content":840,"link":14},"透過食材供需集成平台，台灣中小學的午餐食材與菜單得到嚴格管理。平台串接農業資料，清晰展示食材資訊，並納入認證的章 Q 食材，確保學生享用新鮮健康的午餐。\n\n對偏鄉學校尤其有益，解決了因物流及供應問題所致的午餐品質挑戰。同時，示範案例庫提供學校優質供餐策略參考，升級整體午餐服務品質。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":843},[844],{"type":25,"text":845,"annotations":847,"plain_text":846,"href":14},{"content":846,"link":14},"食材供需集成平台｜CMS 系統",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":849},{"start":850,"end":14,"time_zone":14},"2021-10-01","https://www.notion.so/CMS-a2c1244f57ac4693bb2b76fbe907eef8",{"object":7,"id":853,"created_time":9,"last_edited_time":9,"created_by":854,"last_edited_by":855,"cover":14,"icon":14,"parent":856,"in_trash":18,"is_archived":18,"is_locked":18,"properties":857,"url":916,"public_url":14,"archived":18},"205e4acd-35af-4f40-b5b1-869e0e01d258",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":858,"Tags":863,"Cover":866,"Sort":872,"Skill":874,"LinkRemarks":877,"GitHub":879,"ProjectImage":880,"Client":894,"Link":900,"Text":901,"Name":907,"Update":913},{"id":21,"type":22,"rich_text":859},[860],{"type":25,"text":861,"annotations":862,"plain_text":337,"href":14},{"content":337,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":864},[865],{"id":279,"name":280,"color":281},{"id":39,"type":40,"files":867},[868],{"name":869,"type":44,"external":870},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/ITRI-price-cover.webp",{"url":871},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/ITRI-price-cover.webp",{"id":48,"type":49,"number":873},12,{"id":52,"type":32,"multi_select":875},[876],{"id":55,"name":56,"color":57},{"id":63,"type":22,"rich_text":878},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":881},[882,886,890],{"name":883,"type":44,"external":884},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/ITRI-price-01.webp",{"url":885},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/ITRI-price-01.webp",{"name":887,"type":44,"external":888},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/ITRI-price-02.webp",{"url":889},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/ITRI-price-02.webp",{"name":891,"type":44,"external":892},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/ITRI-price-03.webp",{"url":893},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/ITRI-price-03.webp",{"id":85,"type":22,"rich_text":895},[896],{"type":25,"text":897,"annotations":899,"plain_text":898,"href":14},{"content":898,"link":14},"ITRI",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":902},[903],{"type":25,"text":904,"annotations":906,"plain_text":905,"href":14},{"content":905,"link":14},"消費者在電商平台上購物時，常面對眾多的選擇與價格差異，工研院為此設計了一套系統，運用爬蟲技術，即時抓取電商平台上(如 momo、蝦皮)的商品價格資訊，讓消費者能夠在一個網頁上快速比較同一商品在不同平台上的價格。\n\n考慮到目前的消費模式，手機已經成為最主要的瀏覽和購物工具。為了不增加消費者的操作負擔，工研院特地設計了一個專為手機使用者體驗優化的比價網頁，而非一個需另外下載的APP。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":908},[909],{"type":25,"text":910,"annotations":912,"plain_text":911,"href":14},{"content":911,"link":14},"工研院比價爬蟲專案｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":914},{"start":915,"end":14,"time_zone":14},"2022-04-01","https://www.notion.so/205e4acd35af4f40b5b1869e0e01d258",{"object":7,"id":918,"created_time":9,"last_edited_time":9,"created_by":919,"last_edited_by":920,"cover":14,"icon":14,"parent":921,"in_trash":18,"is_archived":18,"is_locked":18,"properties":922,"url":976,"public_url":14,"archived":18},"323afa84-5821-4fbb-a76f-150b8014ac12",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":923,"Tags":929,"Cover":932,"Sort":938,"Skill":940,"LinkRemarks":944,"GitHub":946,"ProjectImage":947,"Client":955,"Link":960,"Text":961,"Name":967,"Update":973},{"id":21,"type":22,"rich_text":924},[925],{"type":25,"text":926,"annotations":928,"plain_text":927,"href":14},{"content":927,"link":14},"• 後端開發\n• 資料視覺化",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":930},[931],{"id":35,"name":36,"color":37},{"id":39,"type":40,"files":933},[934],{"name":935,"type":44,"external":936},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/iNCKU-airbox-01.webp",{"url":937},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/iNCKU-airbox-01.webp",{"id":48,"type":49,"number":939},13,{"id":52,"type":32,"multi_select":941},[942,943],{"id":55,"name":56,"color":57},{"id":751,"name":752,"color":681},{"id":63,"type":22,"rich_text":945},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":948},[949,951],{"name":935,"type":44,"external":950},{"url":937},{"name":952,"type":44,"external":953},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/iNCKU-airbox-02.webp",{"url":954},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/iNCKU-airbox-02.webp",{"id":85,"type":22,"rich_text":956},[957],{"type":25,"text":958,"annotations":959,"plain_text":769,"href":14},{"content":769,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":962},[963],{"type":25,"text":964,"annotations":966,"plain_text":965,"href":14},{"content":965,"link":14},"成大的空氣盒子不僅是一款微型空氣感測器，該感測器所體現的「參與式感測」與「開放資料」理念，鼓勵公眾參與空氣品質的監測與改善。\n\n本專案的主要目標是利用這些開放的實時數據，提供一個直觀的平台供使用者查詢。我們將複雜的空氣質量數據轉化為容易理解的圖表和指標。不僅如此，這些圖表還能深入揭示二氧化碳量等多項重要指標，幫助使用者即時了解其所處環境的空氣狀態。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":968},[969],{"type":25,"text":970,"annotations":972,"plain_text":971,"href":14},{"content":971,"link":14},"成大空氣盒子專案｜CMS 系統",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":974},{"start":975,"end":14,"time_zone":14},"2021-11-01","https://www.notion.so/CMS-323afa8458214fbba76f150b8014ac12",{"object":7,"id":978,"created_time":9,"last_edited_time":9,"created_by":979,"last_edited_by":980,"cover":14,"icon":14,"parent":981,"in_trash":18,"is_archived":18,"is_locked":18,"properties":982,"url":1049,"public_url":14,"archived":18},"afaca725-0f43-4731-abf9-177b12fd66c2",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":983,"Tags":989,"Cover":992,"Sort":998,"Skill":1000,"LinkRemarks":1003,"GitHub":1005,"ProjectImage":1006,"Client":1028,"Link":1034,"Text":1035,"Name":1041,"Update":1047},{"id":21,"type":22,"rich_text":984},[985],{"type":25,"text":986,"annotations":988,"plain_text":987,"href":14},{"content":987,"link":14},"• 模型串接\n• 後端開發",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":990},[991],{"id":279,"name":280,"color":281},{"id":39,"type":40,"files":993},[994],{"name":995,"type":44,"external":996},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-cover.webp",{"url":997},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-cover.webp",{"id":48,"type":49,"number":999},14,{"id":52,"type":32,"multi_select":1001},[1002],{"id":215,"name":216,"color":37},{"id":63,"type":22,"rich_text":1004},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":1007},[1008,1012,1016,1020,1024],{"name":1009,"type":44,"external":1010},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-01.webp",{"url":1011},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-01.webp",{"name":1013,"type":44,"external":1014},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-02.webp",{"url":1015},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-02.webp",{"name":1017,"type":44,"external":1018},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-03.webp",{"url":1019},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-03.webp",{"name":1021,"type":44,"external":1022},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-04.webp",{"url":1023},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-04.webp",{"name":1025,"type":44,"external":1026},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/odoo-theft-prevention-05.webp",{"url":1027},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/odoo-theft-prevention-05.webp",{"id":85,"type":22,"rich_text":1029},[1030],{"type":25,"text":1031,"annotations":1033,"plain_text":1032,"href":14},{"content":1032,"link":14},"KKDay Inc",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":1036},[1037],{"type":25,"text":1038,"annotations":1040,"plain_text":1039,"href":14},{"content":1039,"link":14},"Odoo 是一款流行的企業資源規劃（ERP）軟體，支持多種業務流程。近年來，隨著線上交易的普及，盜刷問題日益嚴重。為了解決此問題，我們應業主要求開發了基於Odoo的盜刷偵測插件。\n\n這個插件串接AI大數據模型，分析大量訂單的數據特徵，進行快速的盜刷風險評估。在AI的初步評估基礎上，只需少量的人工審查，便可大大降低盜刷風險。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":1042},[1043],{"type":25,"text":1044,"annotations":1046,"plain_text":1045,"href":14},{"content":1045,"link":14},"Odoo 盜刷預測系統｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":1048},{"start":261,"end":14,"time_zone":14},"https://www.notion.so/Odoo-afaca7250f434731abf9177b12fd66c2","page_or_database",{},"2fff23b0-7d30-4f15-9865-176749f0ab6d",{"object":7,"id":264,"created_time":9,"last_edited_time":265,"created_by":1054,"last_edited_by":1055,"cover":14,"icon":14,"parent":1056,"in_trash":18,"is_archived":18,"is_locked":18,"properties":1057,"url":326,"public_url":14,"archived":18,"request_id":1101},{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":1058,"Tags":1063,"Cover":1066,"Sort":1070,"Skill":1071,"LinkRemarks":1076,"GitHub":1078,"ProjectImage":1079,"Client":1083,"Link":1088,"Text":1089,"Name":1094,"Update":1099},{"id":21,"type":22,"rich_text":1059},[1060],{"type":25,"text":1061,"annotations":1062,"plain_text":274,"href":14},{"content":274,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":1064},[1065],{"id":279,"name":280,"color":281},{"id":39,"type":40,"files":1067},[1068],{"name":