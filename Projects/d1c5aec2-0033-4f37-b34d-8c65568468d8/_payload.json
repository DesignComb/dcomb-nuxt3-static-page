":622,"annotations":623,"plain_text":425,"href":14},{"content":425,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":626},[627],{"name":628,"type":44,"external":629},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/kokoni-web.webp",{"url":630},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/kokoni-web.webp",{"id":85,"type":22,"rich_text":632},[633],{"type":25,"text":634,"annotations":635,"plain_text":89,"href":14},{"content":89,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":637},"https://abby-select-store.myshopify.com",{"id":95,"type":22,"rich_text":639},[640],{"type":25,"text":641,"annotations":643,"plain_text":642,"href":14},{"content":642,"link":14},"Kokoni 是「這裏」的意思。透過主理人以及品牌團隊的嚴選，我們期望大家能在這裡找到好吃、好喝、好用、好美的好物。讓我們一起好好生活，慢慢相遇。\n\n根據品牌意象，網頁用極簡的風格，純白的基調，再加上主理人的形象去建置，簡約的畫面，讓大家能在網頁上專注選擇 Kokoni 的商品。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":645},[646],{"type":25,"text":647,"annotations":649,"plain_text":648,"href":14},{"content":648,"link":14},"Kokoni 小日常道具｜電商網站",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":651},{"start":652,"end":14,"time_zone":14},"2022-11-01","https://www.notion.so/Kokoni-58877f554e33420281e65916f844de0a",{"object":7,"id":655,"created_time":9,"last_edited_time":9,"created_by":656,"last_edited_by":657,"cover":14,"icon":14,"parent":658,"in_trash":18,"is_archived":18,"is_locked":18,"properties":659,"url":724,"public_url":14,"archived":18},"e8a781ab-0526-431a-aff4-5981ff150868",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":660,"Tags":665,"Cover":668,"Sort":674,"Skill":676,"LinkRemarks":682,"GitHub":684,"ProjectImage":685,"Client":703,"Link":708,"Text":709,"Name":715,"Update":721},{"id":21,"type":22,"rich_text