alic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":312},[313],{"type":25,"text":314,"annotations":316,"plain_text":315,"href":14},{"content":315,"link":14},"這不只是縮網址!\n我們觀察到縮網址在社群媒體分享資訊時的廣泛應用，但在FB貼文、Line對話貼上一段縮網址，我們只能在預覽看到縮網址平台的資料，很不安心。\n因此，我們的工具在縮網址的同時還能編輯網頁的預覽資訊，這樣發文、傳資料的可信度就又能更上一層樓，更不用說有些SPA的網頁沒辦法針對單頁的資訊預覽，只要透過我們的網址工具，都能完美解決。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":318},[319],{"type":25,"text":320,"annotations":322,"plain_text":321,"href":14},{"content":321,"link":14},"LinkLink網址管理｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":324},{"start":325,"end":14,"time_zone":14},"2023-05-01","https://www.notion.so/LinkLink-d1c5aec200334f37b34d8c65568468d8",{"object":7,"id":328,"created_time":9,"last_edited_time":9,"created_by":329,"last_edited_by":330,"cover":14,"icon":14,"parent":331,"in_trash":18,"is_archived":18,"is_locked":18,"properties":332,"url":390,"public_url":14,"archived":18},"8433259e-c690-41cc-a860-a1bff8b22684",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":333,"Tags":339,"Cover":342,"Sort":348,"Skill":349,"LinkRemarks":352,"GitHub":358,"ProjectImage":360,"Client":368,"Link":373,"Text":375,"Name":381,"Update":387},{"id":21,"type":22,"rich_text":334},[335],{"type":25,"text":336,"annotations":338,"plain_text":337,"href":14},{"content":337,"link":14},"• 介面設計\n• 流程設計\n• 前端開發",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":340},[341],{"id":279,"name":280,"color":281},{"id":39,"type":40,"files":343},[344],{"name":345,"type":44,"external":346},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/chatGPT-speaker.webp",{"url":347},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/chatGPT-speaker.webp",{"id":48,"type":49,"number":289},{"id":52,"type":32,"multi_select":350},[351],{"id":55,"name":56,"color":57},{"id":63,"type":22,"rich_text":353},[354],{"type":25,"text":355,"annotations":357,"plain_text":356,"href":14},{"content":356,"link":14},"※需要自行申請open ai key",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":70,"type":71,"url":359},"https://github.com/DesignComb/chatGPT-speaker",{"id":74,"type":40,"files":361},[362,364],{"name":345,"type":44,"external":363},{"url":347},{"name":365,"type":44,"external":366},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/chatGPT-speaker-2.webp",{"url":367},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/chatGPT-speaker-2.webp",{"id":85,"type":22,"rich_text":369},[370],{"type":25,"text":371,"annotations":372,"plain_text":308,"href":14},{"content":308,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":374},"https://designcomb.github.io/chatGPT-speaker/",{"id":95,"type":22,"rich_text":376},[377],{"type":25,"text":378,"annotations":380,"plain_text":379,"href":14},{"content":379,"link":14},"ChatGPT的易用性相信有目共睹，只要輸入您的問題或想法，AI就能為您解答，而在我們的網站中，還能將這些文字轉成有情感的聲音，讀出來給你聽。\n\n我們專為中文用戶量身訂做，透過微軟的Azure服務，確保每一個字都發音準確，同時可以客製音調、音高，自由排序重組聲音順序等。真正做到讓ChatGPT念給你聽。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":382},[383],{"type":25,"text":384,"annotations":386,"plain_text":385,"href":14},{"content":385,"link":14},"AI 碎碎念｜線上工具",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":388},{"start":389,"end":14,"time_zone":14},"2023-04-01","https://www.notion.so/AI-8433259ec69041cca860a1bff8b22684",{"object":7,"id":392,"created_time":9,"last_edited_time":9,"created_by":393,"last_edited_by":394,"cover":14,"icon":14,"parent":395,"in_trash":18,"is_archived":18,"is_locked":18,"properties":396,"url":460,"public_url":14,"archived":18},"d83bfd28-c5e7-4c99-ba7d-e0d4d0e4088a",{"object"