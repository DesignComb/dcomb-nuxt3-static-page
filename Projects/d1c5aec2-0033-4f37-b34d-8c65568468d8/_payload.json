st-1.amazonaws.com/capsulebackend-2.webp",{"id":85,"type":22,"rich_text":166},[167],{"type":25,"text":168,"annotations":169,"plain_text":89,"href":14},{"content":89,"link":14},{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":171},"https://www.capsuleinc.cc",{"id":95,"type":22,"rich_text":173},[174],{"type":25,"text":175,"annotations":177,"plain_text":176,"href":14},{"content":176,"link":14},"CAPSULE 的創作者形象官網，採用優雅又年輕的風格去彰顯創作者的活力，也網羅每一個創作者活躍的平台、最新的狀況以及各類媒體消息，能讓使用者在創作者頁面中迅速了解每一位創作者的特色。\n\n同時也製作了易管理的後台、每日同步社群媒體最新消息的排程工具，讓網頁好看的同時也好維護。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":179},[180],{"type":25,"text":181,"annotations":183,"plain_text":182,"href":14},{"content":182,"link":14},"CAPSULE 創作者官網｜形象網站",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":185},{"start":186,"end":14,"time_zone":14},"2021-03-01","https://www.notion.so/CAPSULE-05bbe82b6904467eacfc4f82f6e9369d",{"object":7,"id":189,"created_time":190,"last_edited_time":191,"created_by":192,"last_edited_by":193,"cover":14,"icon":14,"parent":194,"in_trash":18,"is_archived":18,"is_locked":18,"properties":195,"url":262,"public_url":14,"archived":18},"3555f4b6-5a43-8077-b7b7-e73ba21048ea","2026-05-03T12:44:00.000Z","2026-05-04T11:45:00.000Z",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":196,"Tags":202,"Cover":205,"Sort":210,"Skill":212,"LinkRemarks":218,"GitHub":220,"ProjectImage":221,"Client":235,"Link":241,"Text":242,"Name":248,"Update":259},{"id":21,"type":22,"rich_text":197},[198],{"type":25,"text":199,"annotations":201,"plain_text":200,"href":14},{"content":200,"link":14},"• 前端開發\n• 後端開發\n• 資料庫設計",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":203},[204],{"id":35,"name":36,"color":37},{"id":39,"type":40,"files":206},[207],{"name":208,"type":44,"external":209},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812519997.jpg",{"url":208},{"id":48,"type":49,"number":211},3,{"id":52,"type":32,"multi_select":213},[214,217],{"id":215,"name":216,"color":37},"24482c8e-31ff-4e50-b48e-23766e4181ea","Python",{"id":55,"name":56,"color":57},{"id":63,"type":22,"rich_text":219},[],{"id":70,"type":71,"url":14},{"id":74,"type":40,"files":222},[223,226,229,232],{"name":224,"type":44,"external":225},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812594537.jpg",{"url":224},{"name":227,"type":44,"external":228},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812629168.jpg",{"url":227},{"name":230,"type":44,"external":231},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812660414.jpg",{"url":230},{"name":233,"type":44,"external":234},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/messageImage_1777812695286.jpg",{"url":233},{"id":85,"type":22,"rich_text":236},[237],{"type":25,"text":238,"annotations":240,"plain_text":239,"href":14},{"content":239,"link":14},"IMstudy",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":92,"type":71,"url":14},{"id":95,"type":22,"rich_text":243},[244],{"type":25,"text":245,"annotations":247,"plain_text":246,"href":14},{"content":246,"link":14},"IMStudy（愛學館）是一套專為補習班與家教中心打造的學習管理系統，將學生與師資管理、課程配置、學收單（帳務）、排課調課與 LINE 通知串接整合於同一平台，協助補教機構把原本分散的行政流程數位化、集中化，大幅減少人工對帳與紙本作業的負擔。\n\n系統涵蓋從學生報名、課堂排程、請假調補課到帳務追蹤的完整營運鏈路，並支援多分校管理與角色權限分工，讓櫃檯、導師與管理  階層能依職務各司其職；同時透過 LINE 即時推播課堂與繳費資訊給家長，強化校方與家庭之間的溝通效率。 ",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":249},[250,255],{"type":25,"text":251,"annotations":253,"plain_text":252,"href":14},{"content":252,"link":14},"愛學館後台管理",{"bold":254,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},true,{"type":25,"text":256,"annotations":258,"plain_text":257,"