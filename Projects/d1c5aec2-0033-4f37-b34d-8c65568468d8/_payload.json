pify.com/",{"id":95,"type":22,"rich_text":446},[447],{"type":25,"text":448,"annotations":450,"plain_text":449,"href":14},{"content":449,"link":14},"300萬訂閱的YouTuber 「阿神」的漢堡店官網！\n\n網頁內採用了大量鮮豔的色彩以及充滿童趣的動態元件，同時清晰呈現 50 家以上的分店資料，並且可以直接在官網的商城中購買 KAMIKAMI Burger 靈魂的麻辣醬。",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":102,"type":102,"title":452},[453],{"type":25,"text":454,"annotations":456,"plain_text":455,"href":14},{"content":455,"link":14},"KAMIKAMI Burger｜電商網站",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":109,"type":110,"date":458},{"start":459,"end":14,"time_zone":14},"2022-08-01","https://www.notion.so/KAMIKAMI-Burger-d83bfd28c5e74c99ba7de0d4d0e4088a",{"object":7,"id":462,"created_time":9,"last_edited_time":9,"created_by":463,"last_edited_by":464,"cover":14,"icon":14,"parent":465,"in_trash":18,"is_archived":18,"is_locked":18,"properties":466,"url":529,"public_url":14,"archived":18},"3b1d0947-2066-4714-8094-71698c7e3dec",{"object":11,"id":12},{"object":11,"id":12},{"type":16,"database_id":17},{"Contributions":467,"Tags":473,"Cover":476,"Sort":482,"Skill":484,"LinkRemarks":487,"GitHub":489,"ProjectImage":490,"Client":508,"Link":513,"Text":514,"Name":520,"Update":526},{"id":21,"type":22,"rich_text":468},[469],{"type":25,"text":470,"annotations":472,"plain_text":471,"href":14},{"content":471,"link":14},"• 流程設計\n• 前端開發",{"bold":18,"italic":18,"strikethrough":18,"underline":18,"code":18,"color":29},{"id":31,"type":32,"multi_select":474},[475],{"id":279,"name":280,"color":281},{"id":39,"type":40,"files":477},[478],{"name":479,"type":44,"external":480},"https://dcomb-web.s3.ap-northeast-1.amazonaws.com/webp/kami-collection-cover.webp",{"url":481},"https://dcomb-web-image.s3.ap-northeast-1.amazonaws.com/kami-collection-cover.webp",{"id":48,"type":49,"number":483},6,{"id":52,"type":32,"multi_select":485},[486],{"id":55,"name":56,"color":57},{"id":63,"type":22,"rich_text":488},[],{"id":70,"type":71,"ur